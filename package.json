    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "chalk": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
